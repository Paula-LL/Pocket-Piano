<!-- FrameLayout raíz: permite superponer capas una encima de otra -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenedor que apila las teclas blancas (abajo) y las negras (encima) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== CAPA 1: TECLAS BLANCAS =====
             Cada ImageButton ocupa el mismo espacio (weight=1) y muestra
             la imagen de su nota musical (do, re, mi...) -->
        <LinearLayout
            android:id="@+id/whiteKeysLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="#A8A8A8">

            <ImageButton
                android:id="@+id/C2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/do_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/D2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/re_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/E2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/mi_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/F2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/fa_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/G2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/sol_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/A2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/la_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/B2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/si_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/C3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/do_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/D3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/re_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/E3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/mi_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/F3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/fa_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/G3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/sol_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/A3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/la_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/B3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/si_note"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/C4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="#A8A8A8"
                android:scaleType="centerCrop"
                android:src="@drawable/do_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck" />
            
        </LinearLayout>

        <!-- ===== CAPA 2: TECLAS NEGRAS (SOSTENIDOS) =====
             Se superpone encima de las blancas gracias al FrameLayout padre.
             Los <View> vacíos actúan como espaciadores para alinear cada
             tecla negra justo entre las blancas que le corresponden.
             El fondo es transparente para no tapar las teclas blancas. -->
        <LinearLayout
            android:id="@+id/blackKeysLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:layout_marginTop="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/C2b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"/>

            <ImageButton
                android:id="@+id/D2b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.0"/>

            <ImageButton
                android:id="@+id/F2b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"/>

            <ImageButton
                android:id="@+id/G2b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"/>

            <ImageButton
                android:id="@+id/A2b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1"
                android:background="#000000"
                android:elevation="5dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>

            <ImageButton
                android:id="@+id/C3b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck,TouchTargetSizeCheck" />

            <View android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"/>

            <ImageButton
                android:id="@+id/D3b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"/>

            <ImageButton
                android:id="@+id/F3b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"/>

            <ImageButton
                android:id="@+id/G3b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <View android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"/>

            <ImageButton
                android:id="@+id/A3b"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1.2"
                android:background="#000000"
                android:elevation="4dp"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="4dp"
                android:src="@drawable/semi_note"
                tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"/>
        </LinearLayout>

    </FrameLayout>
</FrameLayout>
